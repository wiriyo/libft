/* ============================================================
**  test main สำหรับ ft_atoi — เทียบกับ libc atoi
**  compile:  gcc -Wall -Wextra -Werror main.c ft_atoi.c -o test_atoi
**  run:      ./test_atoi   (Windows: test_atoi.exe)
**  วิธีอ่าน: PASS = คืนค่า int ตรง libc ทุกเคส
** ============================================================ */
#include <stdio.h>
#include <stdlib.h>

int	ft_atoi(const char *str);

static int	g_pass;
static int	g_total;
static int	g_total_cases;

static void	test_case(const char *s, const char *label)
{
	int	got;
	int	exp;

	got = ft_atoi(s);
	exp = atoi(s);
	g_total++;
	if (got == exp)
	{
		g_pass++;
		printf("PASS  [%02d/%02d] %-28s (ft=%d libc=%d)\n",
			g_total, g_total_cases, label, got, exp);
	}
	else
		printf("FAIL  [%02d/%02d] %-28s (ft=%d libc=%d)\n",
			g_total, g_total_cases, label, got, exp);
}

int	main(void)
{
	g_total_cases = 16;
	printf("ft_atoi — เทียบกับ libc atoi (%d cases)\n", g_total_cases);
	test_case("42", "เลขปกติ");
	test_case("-42", "ติดลบ");
	test_case("+42", "บวกมีเครื่องหมาย");
	test_case("   \t\n\v\f\r 42", "whitespace นำหน้าทุกแบบ");
	test_case("42abc", "เลขแล้วเจอตัวอักษร → หยุด");
	test_case("abc42", "ตัวอักษรก่อนเลข → 0");
	test_case("", "string ว่าง → 0");
	test_case("--42", "เครื่องหมายซ้อน → 0");
	test_case("- 42", "เครื่องหมายเว้นวรรค → 0");
	test_case("+-42", "เครื่องหมายปน → 0");
	test_case("-2147483648", "INT_MIN (trap! ต้องได้ -2147483648)");
	test_case("2147483647", "INT_MAX");
	test_case("0", "ศูนย์");
	test_case("-0", "ศูนย์ติดลบ");
	test_case("  00042", "เลขนำหน้าศูนย์");
	test_case("  +42abc", "รวมทุกอย่าง: space + เครื่องหมาย + เลข + หยุด");
	if (g_pass == g_total)
		printf("✅ PASSED %d/%d\n", g_pass, g_total);
	else
		printf("❌ FAILED %d/%d — ดู FAIL แล้วแก้ฟังก์ชันต่อได้เลย!\n",
			g_pass, g_total);
	return (g_pass == g_total ? 0 : 1);
}
